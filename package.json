{
  "name": "@local/sidebar-plus",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "DESIGN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "description": "三区式 DeepSeek Harness Web 侧边栏：功能区 / 工作区 / 回收区，液态玻璃皮肤，支持拖拽排序与回收站恢复。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "sidebar",
    "liquid-glass",
    "recycle-bin"
  ],
  "license": "MIT",
  "author": {
    "name": "Shenmuorz",
    "url": "https://github.com/Shenmuorz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Shenmuorz/dsh-sidebar-plus.git"
  },
  "homepage": "https://github.com/Shenmuorz/dsh-sidebar-plus#readme",
  "bugs": {
    "url": "https://github.com/Shenmuorz/dsh-sidebar-plus/issues"
  }
}
